Cell["4) Usar (min) sobre el modelo reducido", "Text",
 CellChangeTimes->{{3.9969460570619907`*^9, 
  3.9969460678520756`*^9}},ExpressionUUID->"a530ecd3-3c21-6144-8fef-\
2f0b8a2ec572"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"nc", "=", 
   RowBox[{
    RowBox[{"Dimensions", "[", "Ac", "]"}], "[", 
    RowBox[{"[", "1", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"mc", "=", 
   RowBox[{
    RowBox[{"Dimensions", "[", "Ac", "]"}], "[", 
    RowBox[{"[", "2", "]"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"sc", "=", 
  RowBox[{"MatrixRank", "[", "Ac", "]"}]}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ic", "=", 
   RowBox[{"Subsets", "[", 
    RowBox[{
     RowBox[{"Range", "[", "nc", "]"}], ",", 
     RowBox[{"{", "sc", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Jc", " ", "=", " ", 
   RowBox[{"Subsets", "[", 
    RowBox[{
     RowBox[{"Range", "[", "mc", "]"}], ",", 
     RowBox[{"{", "sc", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"minc", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<=", 
    RowBox[{
     RowBox[{"Dimensions", "[", "Ic", "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"j", "=", "1"}], ",", 
     RowBox[{"j", "<=", 
      RowBox[{
       RowBox[{"Dimensions", "[", "Jc", "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
     RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"minc", "=", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"minc", ",", 
         RowBox[{
          RowBox[{"Det", "[", 
           RowBox[{"Ac", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"Ic", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"Jc", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], "]"}], 
          RowBox[{"Det", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "Bc", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"Jc", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", 
              RowBox[{"Ic", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], "]"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"Print", "[", "minc", "]"}], ";"}]}], "\[IndentingNewLine]", 
    "]"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"Xor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"AnyTrue", "[", 
       RowBox[{"minc", ",", "Positive"}], "]"}], "&&", 
      RowBox[{"AnyTrue", "[", 
       RowBox[{"minc", ",", "Negative"}], "]"}], "&&", 
      RowBox[{"AnyTrue", "[", 
       RowBox[{"minc", ",", 
        RowBox[{"EqualTo", "[", "0", "]"}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"AnyTrue", "[", 
       RowBox[{"minc", ",", 
        RowBox[{"EqualTo", "[", "0", "]"}]}], "]"}], "==", "False"}]}], " ", 
    "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<No es S-inyectiva\>\"", "]"}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{
