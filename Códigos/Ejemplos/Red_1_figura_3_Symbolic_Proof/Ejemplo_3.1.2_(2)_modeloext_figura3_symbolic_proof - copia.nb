Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{
  RowBox[{"Ie", "=", 
   RowBox[{"Subsets", "[", 
    RowBox[{
     RowBox[{"Range", "[", "ne", "]"}], ",", 
     RowBox[{"{", "se", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Je", " ", "=", " ", 
   RowBox[{"Subsets", "[", 
    RowBox[{
     RowBox[{"Range", "[", "me", "]"}], ",", 
     RowBox[{"{", "se", "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"min", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"set", "=", 
   RowBox[{"{", "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"For", "[", 
  RowBox[{
   RowBox[{"i", "=", "1"}], ",", 
   RowBox[{"i", "<=", 
    RowBox[{
     RowBox[{"Dimensions", "[", "Ie", "]"}], "[", 
     RowBox[{"[", "1", "]"}], "]"}]}], ",", 
   RowBox[{"i", "++"}], ",", "\[IndentingNewLine]", 
   RowBox[{"For", "[", 
    RowBox[{
     RowBox[{"j", "=", "1"}], ",", 
     RowBox[{"j", "<=", 
      RowBox[{
       RowBox[{"Dimensions", "[", "Je", "]"}], "[", 
       RowBox[{"[", "1", "]"}], "]"}]}], ",", " ", 
     RowBox[{"j", "++"}], ",", "\[IndentingNewLine]", 
     RowBox[{
      RowBox[{"min", "=", 
       RowBox[{"AppendTo", "[", 
        RowBox[{"min", ",", 
         RowBox[{
          RowBox[{"Det", "[", 
           RowBox[{"A", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"Ie", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"Je", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], "]"}], 
          RowBox[{"Det", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "B", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"Je", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", 
              RowBox[{"Ie", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], "]"}]}]}], 
        "]"}]}], ";", "\[IndentingNewLine]", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{
         RowBox[{
          RowBox[{"Det", "[", 
           RowBox[{"A", "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"Ie", "[", 
               RowBox[{"[", "i", "]"}], "]"}], ",", 
              RowBox[{"Je", "[", 
               RowBox[{"[", "j", "]"}], "]"}]}], "]"}], "]"}], "]"}], 
          RowBox[{"Det", "[", 
           RowBox[{
            RowBox[{"Transpose", "[", "B", "]"}], "[", 
            RowBox[{"[", 
             RowBox[{
              RowBox[{"Je", "[", 
               RowBox[{"[", "j", "]"}], "]"}], ",", 
              RowBox[{"Ie", "[", 
               RowBox[{"[", "i", "]"}], "]"}]}], "]"}], "]"}], "]"}]}], "!=", 
         "0"}], ",", "\[IndentingNewLine]", 
        RowBox[{
         RowBox[{"aux", "=", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"Ie", "[", 
             RowBox[{"[", "i", "]"}], "]"}], ",", 
            RowBox[{"Je", "[", 
             RowBox[{"[", "j", "]"}], "]"}]}], "}"}]}], ";", 
         "\[IndentingNewLine]", 
         RowBox[{"set", "=", 
          RowBox[{"AppendTo", "[", 
           RowBox[{"set", ",", "aux"}], "]"}]}], ";"}]}], 
       "\[IndentingNewLine]", "]"}]}]}], "\[IndentingNewLine]", "]"}]}], 
  "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "min", "]"}], "\[IndentingNewLine]", 
 RowBox[{"Print", "[", "set", "]"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{"Xor", "[", 
    RowBox[{
     RowBox[{
      RowBox[{"AnyTrue", "[", 
       RowBox[{"min", ",", "Positive"}], "]"}], "&&", 
      RowBox[{"AnyTrue", "[", 
       RowBox[{"min", ",", "Negative"}], "]"}], "&&", 
      RowBox[{"AnyTrue", "[", 
       RowBox[{"min", ",", 
        RowBox[{"EqualTo", "[", "0", "]"}]}], "]"}]}], ",", 
     RowBox[{
      RowBox[{"AnyTrue", "[", 
       RowBox[{"min", ",", 
        RowBox[{"EqualTo", "[", "0", "]"}]}], "]"}], "==", "False"}]}], " ", 
    "]"}], ",", "\[IndentingNewLine]", 
   RowBox[{"Print", "[", "\"\<No es S-inyectiva\>\"", "]"}]}], 
  "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"AnyTrue", "[", 
      RowBox[{"min", ",", "Positive"}], "]"}], "==", "True"}], "&&", 
    RowBox[{
     RowBox[{"AnyTrue", "[", 
      RowBox[{"min", ",", "Negative"}], "]"}], "==", "False"}], "&&", 
    RowBox[{"AnyTrue", "[", 
     RowBox[{"min", ",", 
      RowBox[{"EqualTo", "[", "0", "]"}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
   "Print", "[", "\"\<Es S-inyectiva. Tiene, al menos, un valor positivo y \
los demas nulos.\>\"", "]"}]}], "\[IndentingNewLine]", "]"}], "\[IndentingNewLine]", 
 RowBox[{"If", "[", 
  RowBox[{
   RowBox[{
    RowBox[{
     RowBox[{"AnyTrue", "[", 
      RowBox[{"min", ",", "Positive"}], "]"}], "==", "False"}], "&&", 
    RowBox[{
     RowBox[{"AnyTrue", "[", 
      RowBox[{"min", ",", "Negative"}], "]"}], "==", "True"}], "&&", 
    RowBox[{"AnyTrue", "[", 
     RowBox[{"min", ",", 
      RowBox[{"EqualTo", "[", "0", "]"}]}], "]"}]}], ",", 
   "\[IndentingNewLine]", 
   RowBox[{
   "Print", "[", "\"\<Es S-inyectiva. Tiene, al menos, un valor negativo y \
los demas nulos.\>\"", "]"}]}], "\[IndentingNewLine]", "]"}]}], "Input",
