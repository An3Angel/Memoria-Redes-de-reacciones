Cell["\<\
Ejemplo para una red con reacciones no reversibles
x1->Y1->x3
         x2\
\>", "Text",
 CellChangeTimes->{{3.9937275611101913`*^9, 
  3.9937275879634056`*^9}},ExpressionUUID->"2baca50b-8fca-c34a-990a-\
19239c33a779"],

Cell[CellGroupData[{

Cell[BoxData[{
 RowBox[{"Clear", "[", 
  RowBox[{"Ae", ",", "F", ",", "C1"}], "]"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Id3", "=", 
   RowBox[{"IdentityMatrix", "[", "3", "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Ae", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"-", "1"}], ",", "0", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "1", ",", "0"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"0", ",", "0", ",", "1"}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"1", ",", 
       RowBox[{"-", "1"}], ",", 
       RowBox[{"-", "1"}]}], "}"}]}], "}"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"C1", "=", 
   RowBox[{"Transpose", "[", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{
       RowBox[{"Id3", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "+", 
       RowBox[{"Id3", "[", 
        RowBox[{"[", "2", "]"}], "]"}]}], ",", 
      RowBox[{
       RowBox[{"Id3", "[", 
        RowBox[{"[", "1", "]"}], "]"}], "+", 
       RowBox[{"Id3", "[", 
        RowBox[{"[", "3", "]"}], "]"}]}]}], "}"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"Zero", "=", 
   RowBox[{"ConstantArray", "[", 
    RowBox[{"0", ",", 
     RowBox[{"{", 
      RowBox[{"3", ",", "1"}], "}"}]}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{
  RowBox[{"F", "=", 
   RowBox[{"Join", "[", 
    RowBox[{"Id3", ",", "Zero", ",", "2"}], "]"}]}], ";"}], "\[IndentingNewLine]", 
 RowBox[{"MatrixForm", "[", 
  RowBox[{"F", ".", "Ae", ".", "C1"}], "]"}], "\[IndentingNewLine]"}], "Input",
 CellChangeTimes->{{3.993727670613922*^9, 3.993727827645338*^9}, {
